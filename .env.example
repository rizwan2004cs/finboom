# ─────────────────────────────────────────────────────────────────────────────
# FinBoom environment variables
# Copy this file to `.env.local` and fill in the values:  cp .env.example .env.local
# Never commit `.env.local` — only this example file is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth: Clerk ──────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional — enables the welcome email on sign-up. Clerk dashboard → Webhooks →
# add endpoint https://<your-site>/api/webhooks/clerk, subscribe to `user.created`,
# then paste the signing secret (whsec_…) here.
CLERK_WEBHOOK_SECRET=whsec_xxx

# ── Database: Supabase ───────────────────────────────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only secret for cron jobs / exchange rates (bypasses RLS) — keep secret.
# Use the new "secret key" (sb_secret_…) from Project Settings → API Keys, OR the
# legacy service-role JWT. Either env name works; SUPABASE_SECRET_KEY is preferred.
SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # legacy alternative
# Set to "true" only after wiring Clerk as a Supabase Third-Party Auth provider
# and applying the per-user RLS migration. See docs/SECURITY-RLS-ROLLOUT.md.
NEXT_PUBLIC_SUPABASE_CLERK_AUTH=false

# ── Web Push (notifications) ─────────────────────────────────────────────────
# Generate a key pair:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ── Email (branded reminders + blog) ─────────────────────────────────────────
# Optional — without any transport configured the app simply skips email and
# keeps working. Two options; Gmail is preferred when both are set.
#
# Option A — Gmail SMTP (no custom domain needed; ~500 emails/day). Best if you
# host on a *.vercel.app subdomain (which can't be verified for email):
#   1) Enable 2-Step Verification: https://myaccount.google.com/security
#   2) Create an App Password:      https://myaccount.google.com/apppasswords
#   3) Paste the 16-char password below (spaces are fine; "From" shows your Gmail).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
#
# Option B — Resend (free 3,000/mo, 100/day). Needs a verified domain to email
# anyone; until then it only delivers to your own Resend account email.
#   1) Sign up at https://resend.com  2) API Keys → create  3) verify a domain.
RESEND_API_KEY=re_xxx
EMAIL_FROM=FinBoom <onboarding@resend.dev>

# ── Cron protection ──────────────────────────────────────────────────────────
# Any random string; Vercel sends it as a bearer token to /api/cron/* endpoints.
CRON_SECRET=your-long-random-string

# ── Blog CMS: Sanity ─────────────────────────────────────────────────────────
# https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Write token — only needed to publish/regenerate blog posts.
SANITY_EDITOR_TOKEN=your-sanity-write-token

# ── Blog AI providers (only needed for blog automation) ──────────────────────
# At least one is required for `npm run blog:*` and the daily blog cron.
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=            # optional fallback
OPENAI_API_KEY=          # optional fallback

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical base URL used for SEO, sitemap and RSS. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
